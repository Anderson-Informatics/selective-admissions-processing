# MongoDB
# Connection string for the main application database (ehs/app/cycles etc.)
NUXT_MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ehs-processing?retryWrites=true&w=majority

# Optional separate connection string for legacy lookup-tool databases
# Leave the same as NUXT_MONGODB_URI if everything is in one cluster.
NUXT_MONGODB_LOOKUP_URI=mongodb+srv://user:password@cluster.mongodb.net/ehs-processing?retryWrites=true&w=majority

# Submittable API
# The API key is used with HTTPBasicAuth(':', api_key) against the Submittable v4 API.
NUXT_SUBMITTABLE_API_KEY=your_submittable_api_key_here
# Optional: override the Submittable API base URL (defaults to https://submittable-api.submittable.com/v4)
# NUXT_SUBMITTABLE_BASE_URL=https://submittable-api.submittable.com/v4

# Here (geocoding) API key for address geocoding / catchment checks
NUXT_HERE_API_KEY=your_here_api_key_here

# EHS Registration API (external student test-registration database)
# Sent as the `x-api-key` header on GET/POST /api/external/students calls.
NUXT_REGISTRATION_API_KEY=your_registration_api_key_here
# Optional: override the registration API base URL
# NUXT_REGISTRATION_BASE_URL=https://ehs-registration-v2.netlify.app

# Bootstrap site administrator
# Used once, only when the users collection is empty, to seed the first site-admin
# account. Additional users are added via site-admin invitations.
NUXT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NUXT_BOOTSTRAP_ADMIN_PASSWORD=generate_a_strong_password_12_chars_min

# Session secret used to sign/login state cookies. Generate a strong random string.
NUXT_AUTH_SECRET=generate_a_strong_random_secret_at_least_32_chars

# Server-only credentials for GET /api/data/applicants.
# Clients send only NUXT_DATA_KEY in the Authorization: Bearer header.
NUXT_DATA_KEY=generate_a_private_random_api_key
NUXT_DATA_SECRET=generate_a_separate_private_random_hmac_secret

# MSAL / Azure AD (future SSO phase)
# NUXT_MSAL_TENANT_ID=your_azure_tenant_id
# NUXT_MSAL_CLIENT_ID=your_azure_app_client_id
# NUXT_MSAL_CLIENT_SECRET=your_azure_app_client_secret
# NUXT_MSAL_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional Microsoft Teams / Power Automate webhook for notifications
# NUXT_TEAMS_WEBHOOK_URL=https://prod-00.westus.logic.azure.com/...
# NUXT_TEAMS_WEBHOOK_SECRET=optional_signature_secret

# Background job dispatch
# Generate a private random value used only between server-side functions.
NUXT_JOB_DISPATCH_SECRET=generate_a_private_random_dispatch_secret
NUXT_JOB_CONCURRENCY=3
NUXT_JOB_MAX_ATTEMPTS=3

# Public app URL used for callbacks and absolute links
NUXT_PUBLIC_APP_URL=http://localhost:3000
